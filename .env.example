# Proposal Orchestrator — Transport Configuration
#
# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.
#
# SECURITY: Never commit .env or any file containing credentials.
# SECURITY: Rotate AWS credentials immediately if this file is exposed.
# SECURITY: For production, use IAM roles / instance profiles instead of
#           long-term access keys.

# --- Transport preset (recommended) ---
# Sets backend, endpoint, model, and capabilities in one variable.
# See docs/backend/transport_presets.md for all presets.
ORCHESTRATOR_TRANSPORT_PRESET=BEDROCK_EU_DEVELOPMENT

# --- API key (required for Bedrock / Together AI) ---
# Generate in the Amazon Bedrock console. Never commit this value.
ORCHESTRATOR_TRANSPORT_API_KEY=<your-bedrock-api-key>

# --- Model override (optional) ---
# Bedrock model IDs use <provider>.<model> format.
ORCHESTRATOR_TRANSPORT_MODEL=anthropic.claude-sonnet-4-20250514-v1:0

# --- AWS region (optional) ---
# Only used when ORCHESTRATOR_TRANSPORT_ENDPOINT is not set
# AND the preset has no default_endpoint.
# NOTE: BEDROCK_EU_DEVELOPMENT hardcodes eu-west-1 as its default endpoint.
# To use a different region, set ORCHESTRATOR_TRANSPORT_ENDPOINT explicitly.
AWS_REGION=eu-west-1

# --- Explicit endpoint override (optional) ---
# Overrides both preset default and AWS_REGION-derived URL.
# Uncomment and set to target a specific region:
# ORCHESTRATOR_TRANSPORT_ENDPOINT=https://bedrock-mantle.eu-central-1.api.aws/v1

# --- Production mode (recommended for staging and production) ---
# When true, rejects non-production backends and enforces fail-closed behavior.
# In production mode, only bedrock_converse and bedrock backends are accepted.
# The default claude_cli backend is rejected in production mode.
# ORCHESTRATOR_PRODUCTION_MODE=true

# --- Diagnostic persistence level ---
# Controls what diagnostic data is written to disk.
#   "full"     — Full response text, prompts on failure, parsed output (default in dev).
#   "metadata" — Metadata only: char counts, timing, error class. No content (default in prod).
# In production mode, "full" is rejected as a policy violation.
# ORCHESTRATOR_DIAGNOSTIC_LEVEL=metadata

# --- Claude CLI pin (claude_cli backend only) ---
# Absolute path to the `claude` executable the runner should spawn.
#
# Why pin: the runner spawns the CLI with shell=False, so the OS resolves the
# name through PATH x PATHEXT — which is NOT the resolution your shell
# performs. On Windows these have been observed to disagree (Python resolved
# claude.EXE 2.1.81 while PowerShell ran claude.ps1 2.1.224), so the runner
# silently exercised a different build, with a different MCP surface and a
# ~3-5x different per-invocation cost, than the one under test.
#
# Discover the candidates and get a ready-to-paste value:
#     python tools/diag_cli_resolution.py
#
# Windows: pin the .exe or .cmd, never the .ps1 — CreateProcess cannot start
# a PowerShell script, and the transport rejects such a pin at resolution.
# Unset = resolve on PATH (the absolute result is still logged with --verbose).
# A value that names a missing file fails the run; it never falls back.
# ORCHESTRATOR_CLAUDE_CLI_PATH=C:\Users\you\.local\bin\claude.exe
