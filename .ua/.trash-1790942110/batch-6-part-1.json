    {
      "id": "file:runner/graph_canonical_pack.py",
      "type": "file",
      "name": "graph_canonical_pack.py",
      "filePath": "runner/graph_canonical_pack.py",
      "summary": "Deterministic, Claude-free deriver that builds the Phase-8 canonical reference pack (objectives, outcomes, work packages, deliverables, partners) from graph vault nodes instead of docs/** JSON, so the pack and the compiled prose share one source and cannot drift. Operator-declared assumptions are read from a separate substrate and quarantined into their own array rather than merged into confirmed facts.",
      "tags": ["deterministic-component", "graph-substrate", "canonical-pack", "provenance", "cli"],
      "complexity": "complex",
      "languageNotes": "Every emitted field is a verbatim copy of declared node front-matter; the only computed value is a pure dict lookup from evidence_strength to a provenance tag, which is what makes the same vault yield a byte-identical pack."
    },
    {
