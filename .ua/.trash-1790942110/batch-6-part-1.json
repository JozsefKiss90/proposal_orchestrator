    {
      "id": "file:runner/graph_claim_verifier.py",
      "type": "file",
      "name": "graph_claim_verifier.py",
      "filePath": "runner/graph_claim_verifier.py",
      "summary": "Independent claim-to-node traceability auditor: reads the committed Tier 5 section artifacts from disk (never a fresh compile) plus the vault, and asserts that every published claim_id is a bound vault node whose status equals the schema's evidence mapping. Distinguishes audit findings from fail-closed preconditions, and refuses to pass vacuously when there is nothing to verify.",
      "tags": ["verification", "traceability", "audit", "graph-substrate", "fail-closed"],
      "complexity": "complex",
      "languageNotes": "Its independence is structural: it imports the shared vault reader and schema but deliberately not the compiler, so a compiler whose status projection drifted is caught rather than blessed."
    },
