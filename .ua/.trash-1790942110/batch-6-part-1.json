    {
      "id": "file:runner/graph_compiler.py",
      "type": "file",
      "name": "graph_compiler.py",
      "filePath": "runner/graph_compiler.py",
      "summary": "The graph-to-docs compiler: reads a config-bound vault and deterministically extracts both the Tier 3 architecture_inputs JSON and the Part B proposal_section deliverables, writing them into a Tier 4 staging tree and diffing against the existing hand-lift rather than overwriting it. Record validation status is always computed from the node's evidence_strength, never read from the node, so an unconfirmed node can never land as a confirmed fact.",
      "tags": ["compiler", "graph-substrate", "deterministic-component", "staging", "cli"],
      "complexity": "complex",
      "languageNotes": "The largest module in the graph substrate; two extraction slices (Tier 3 and Part B) share one mechanism — read the vault, route by config binding, copy declared fields verbatim, compute status by lookup — so adding a slice means adding a binding, not a code path."
    },
