    "deterministic-component",
    "claim-status",
    "phase8",
    "validation",
    "tier3"
   ],
   "complexity": "moderate",
   "languageNotes": "Idempotent by construction: a second pass finds no unresolved claim left to flip and writes nothing."
  },
