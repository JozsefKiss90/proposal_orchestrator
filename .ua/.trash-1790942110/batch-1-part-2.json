    "cli",
    "entry-point",
    "calibration"
   ],
   "complexity": "complex"
  },
  {
   "id": "function:harness/commands/freeze_grounding_baselines.py:build_paced_judge",
   "type": "function",
   "name": "build_paced_judge",
   "filePath": "harness/commands/freeze_grounding_baselines.py",
   "lineRange": [
    210,
    233
   ],
   "summary": "Constructs the pinned judge wrapped in the paced, retrying backend so every judge call in the freeze passes through one rate-limiting choke point.",
