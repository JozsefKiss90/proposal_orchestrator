    "resumable",
    "judge",
    "error-handling"
   ],
   "complexity": "moderate"
  },
  {
   "id": "function:harness/commands/faithfulness_calibration.py:main",
   "type": "function",
   "name": "main",
   "filePath": "harness/commands/faithfulness_calibration.py",
   "lineRange": [
    137,
    242
   ],
   "summary": "Calibration run entry point: loads the gold set and checkpoint, paces the judge calls, computes precision and recall, applies the graduation threshold and writes the decision-log draft.",
