    "factory",
    "rate-limiting",
    "judge"
   ],
   "complexity": "simple"
  },
  {
   "id": "function:harness/commands/freeze_grounding_baselines.py:main",
   "type": "function",
   "name": "main",
   "filePath": "harness/commands/freeze_grounding_baselines.py",
   "lineRange": [
    241,
    355
   ],
   "summary": "Freeze entry point: iterates the committed sections, skips any already frozen under the current judge pin, and writes one grounding baseline per section with resume on interruption.",
   "tags": [
    "cli",
    "entry-point",
    "resumable"
   ],
   "complexity": "complex"
  },
  {
   "id": "class:harness/commands/freeze_grounding_baselines.py:PacedRetryingBackend",
   "type": "class",
   "name": "PacedRetryingBackend",
   "filePath": "harness/commands/freeze_grounding_baselines.py",
   "lineRange": [
    95,
    207
   ],
   "summary": "Backend wrapper that paces every judge call under a TPM/RPM budget using the backend's real token usage and retries the provider's own retryable errors with exponential backoff, honouring a try-again hint.",
   "tags": [
    "rate-limiting",
    "retry",
    "decorator"
   ],
   "complexity": "complex"
  },
  {
   "id": "function:harness/commands/rubric_grading_run.py:compute_budget_plan",
   "type": "function",
   "name": "compute_budget_plan",
   "filePath": "harness/commands/rubric_grading_run.py",
   "lineRange": [
    155,
    299
   ],
   "summary": "Computes the full offline call and token plan for the grid (expectations by mapped sections by N>=3, coverage plus grounding, cross-pack claim dedup) and records it before the first judge call, making a multi-day resume explicit rather than silently shrinking the panel.",
   "tags": [
    "budget-planning",
    "deterministic",
    "planning"
   ],
   "complexity": "complex"
  },
  {
