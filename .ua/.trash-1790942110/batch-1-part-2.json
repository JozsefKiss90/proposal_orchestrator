  {
   "id": "file:harness/commands/blind_assessment.py",
   "type": "file",
   "name": "blind_assessment.py",
   "filePath": "harness/commands/blind_assessment.py",
   "summary": "Command-line entry point for the blind assessment lane: assesses one candidate directory or dev-graph document against a pre-evaluation profile, or re-binds a persisted report to the candidate on disk and rejects it when the candidate changed.",
   "tags": [
    "cli",
    "entry-point",
    "blind-assessment",
    "argparse"
   ],
   "complexity": "moderate"
  },
  {
   "id": "file:harness/commands/faithfulness_calibration.py",
   "type": "file",
   "name": "faithfulness_calibration.py",
   "filePath": "harness/commands/faithfulness_calibration.py",
   "summary": "Turnkey, resumable runner for the E1.5 faithfulness calibration: judges every gold-set pair through a paced/retrying backend, checkpoints predictions per pair, salvages verdicts from malformed judge JSON, and writes a decision-log draft with the graduation outcome.",
   "tags": [
    "cli",
    "entry-point",
    "calibration",
    "resumable"
   ],
   "complexity": "complex"
  },
  {
   "id": "file:harness/commands/freeze_grounding_baselines.py",
   "type": "file",
   "name": "freeze_grounding_baselines.py",
   "filePath": "harness/commands/freeze_grounding_baselines.py",
   "summary": "Freezes the judge half of the E4 regression golden set section by section, injecting a single paced and retrying backend choke point so a rate-limited judge (TPM/RPM caps, 429s) cannot abort the run; already frozen sections are skipped on re-run.",
   "tags": [
    "cli",
    "entry-point",
    "rate-limiting",
    "regression"
   ],
   "complexity": "complex"
  },
  {
   "id": "file:harness/commands/rubric_grading_run.py",
   "type": "file",
   "name": "rubric_grading_run.py",
   "filePath": "harness/commands/rubric_grading_run.py",
   "summary": "Drives the E5 rubric grid over the committed Part B sections under an explicit judge budget: computes and records the full call/token plan before the first judge call, checkpoints every grid cell for multi-day resume, and freezes both the grid report and the E4 rubric-lane baseline.",
   "tags": [
    "cli",
    "entry-point",
    "budget-planning",
    "resumable"
   ],
   "complexity": "complex"
  },
  {
   "id": "file:harness/evidence_pack.py",
   "type": "file",
   "name": "evidence_pack.py",
   "filePath": "harness/evidence_pack.py",
   "summary": "Deterministic evidence-pack builder that keeps each rubric judge call inside the token budget: selects the prose spans and claim-ledger entries bearing on an expectation by versioned term matching and anchor sub-section bonuses, then records every excluded item and the reason it was dropped.",
   "tags": [
    "evidence-pack",
    "deterministic",
    "token-budget",
    "serialization"
   ],
   "complexity": "complex"
  },
  {
