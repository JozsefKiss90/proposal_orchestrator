{
 "nodes": [
  {
   "id": "file:runner/fingerprints.py",
   "type": "file",
   "name": "fingerprints.py",
   "filePath": "runner/fingerprints.py",
   "summary": "Single source of truth for reducing a gate input artifact to a deterministic SHA-256 content fingerprint. Imported by both the writer side (gate_evaluator, which stamps input_artifact_fingerprints into every gate result) and the reader side (is_gate_fresh), so content-based staleness cannot diverge.",
   "tags": [
    "utility",
    "content-fingerprint",
    "gate-freshness",
    "determinism"
   ],
   "complexity": "simple",
   "languageNotes": "Kept as a leaf module depending only on runner.paths and the standard library, because importing the helper back from gate_evaluator would form an import cycle."
  },
  {
   "id": "file:runner/gate_evaluator.py",
   "type": "file",
   "name": "gate_evaluator.py",
   "filePath": "runner/gate_evaluator.py",
   "summary": "The sole entry point for evaluating one gate: resolves predicates from the compiled manifest's predicate_refs, runs every deterministic predicate without fast-fail, dispatches semantic predicates only when all deterministic ones pass, writes the canonical Tier 4 GateResult, updates node state and propagates HARD_BLOCK from the budget gate.",
   "tags": [
    "gate-evaluation",
    "entry-point",
    "orchestration",
    "fail-closed",
    "service"
   ],
   "complexity": "complex",
   "languageNotes": "Approach B predicate resolution: the compiled manifest is the composition source (predicate_refs) and the gate library is the implementation registry, with Approach A (library predicate list) as fallback when the manifest is absent."
  },
  {
   "id": "file:runner/gate_library.py",
   "type": "file",
   "name": "gate_library.py",
   "filePath": "runner/gate_library.py",
   "summary": "Loader and validator for gate_rules_library.yaml, the implementation registry that maps each gate_id to its executable predicates, and refuses to load when the library's manifest_version disagrees with the runner's.",
   "tags": [
    "gate-registry",
    "configuration-loader",
    "validation",
    "yaml"
   ],
   "complexity": "complex"
  },
  {
   "id": "file:runner/gate_result_registry.py",
   "type": "file",
   "name": "gate_result_registry.py",
   "filePath": "runner/gate_result_registry.py",
   "summary": "Authoritative table of canonical Tier 4 gate result paths, plus the shared gate-result schema_id, Tier 4 root and version-field constants that the evaluator, the gate_pass_recorded predicate and the backfill tool all read instead of re-hardcoding.",
   "tags": [
    "constants",
    "registry",
    "gate-results",
    "single-source-of-truth"
   ],
   "complexity": "moderate"
  },
  {
   "id": "file:runner/paths.py",
   "type": "file",
   "name": "paths.py",
   "filePath": "runner/paths.py",
   "summary": "Deterministic repository-root discovery (an ancestor holding both CLAUDE.md and .git/) and repo-relative artifact path resolution. Every predicate resolves paths through it rather than inlining path logic.",
   "tags": [
    "utility",
    "path-resolution",
    "filesystem",
    "determinism"
   ],
   "complexity": "simple"
  },
  {
