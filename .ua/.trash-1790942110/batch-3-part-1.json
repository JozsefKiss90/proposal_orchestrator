   "filePath": "runner/fingerprints.py",
   "lineRange": [
    39,
    57
   ],
   "summary": "Computes the deterministic SHA-256 fingerprint of one path, returning a MISSING sentinel when the file is absent so an input appearing or disappearing counts as a real content change.",
