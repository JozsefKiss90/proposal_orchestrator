   "id": "file:harness/jsonl_log.py",
   "type": "file",
   "name": "jsonl_log.py",
   "filePath": "harness/jsonl_log.py",
   "summary": "Shared append-only JSONL log base: seeds from any pre-existing file, mirrors records in memory, and atomically re-serializes the whole file on every append so a reader never sees a torn line.",
   "tags": [
    "utility",
    "logging",
    "atomic-write",
    "base-class"
   ],
   "complexity": "moderate"
  },
  {
   "id": "file:harness/judge.py",
   "type": "file",
   "name": "judge.py",
   "filePath": "harness/judge.py",
   "summary": "The independent judge: a pinned, temperature-zero, non-drafter model over the OpenAI-compatible transport that enforces grader/generator independence, refuses to silently repair a malformed response, and logs provenance for every verdict before returning it.",
   "tags": [
    "judge",
    "llm-integration",
    "provenance",
    "service"
   ],
   "complexity": "complex",
   "languageNotes": "Dependency injection by backend callable keeps the judge testable with no network; the drafter-model blocklist and transport check are enforced in JudgeConfig construction rather than at call time."
  },
  {
   "id": "file:harness/ledger_granularity.py",
