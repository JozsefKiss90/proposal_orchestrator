      "complexity": "moderate"
    },

    {
      "id": "file:runner/graph_determinism_check.py",
      "type": "file",
      "name": "graph_determinism_check.py",
      "filePath": "runner/graph_determinism_check.py",
      "summary": "Replay auditor that proves the compiler is a pure function of the vault: it compiles the same vault twice into two separate staging roots with deliberately different compiled_at stamps and shows the outputs are byte-identical apart from that one documented exclusion. Byte-exact on the fast path, falling back to order-preserving canonical JSON so a reordered key or array element is flagged rather than masked.",
      "tags": ["determinism", "verification", "replay", "graph-substrate", "cli"],
      "complexity": "complex",
      "languageNotes": "Feeding the two compiles maximally different timestamps turns a weak claim (two runs happened to agree) into a strong one (even when the stamp differs, nothing else does)."
    },
    {
      "id": "class:runner/graph_determinism_check.py:DeterminismCheckError",
      "type": "class",
      "name": "DeterminismCheckError",
      "filePath": "runner/graph_determinism_check.py",
      "lineRange": [120, 130],
      "summary": "Raised when the check cannot run at all — a malformed config or vault, or a config that compiles to nothing, which is refused rather than vacuously passed.",
      "tags": ["exception", "fail-closed", "error-handling"],
      "complexity": "simple"
    },
    {
      "id": "class:runner/graph_determinism_check.py:DeterminismFinding",
      "type": "class",
      "name": "DeterminismFinding",
      "filePath": "runner/graph_determinism_check.py",
      "lineRange": [139, 153],
      "summary": "One divergence between the two compiles: the staged path, the kind of divergence, and a detail locating it.",
