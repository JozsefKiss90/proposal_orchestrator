      "summary": "Reads an optional string config field, rejecting a present-but-blank value instead of treating it as absent.",
      "tags": ["validation", "helper", "fail-closed"],
      "complexity": "simple"
    },
    {
      "id": "function:runner/graph_config.py:_parse_binding",
      "type": "function",
      "name": "_parse_binding",
