  "nodes": [
    {
      "id": "file:runner/graph_config.py",
      "type": "file",
      "name": "graph_config.py",
      "filePath": "runner/graph_config.py",
      "summary": "Defines and validates the per-project graph.config.yaml binding contract — which vault folders and node types map to which target tier and canonical docs/** artifact path. This is the only place project specifics enter the graph substrate, which is what keeps the generic layer free of project nouns.",
      "tags": ["configuration", "graph-substrate", "validation", "fail-closed", "programme-agnostic"],
      "complexity": "moderate",
      "languageNotes": "Bindings are scanned in file order with first-match-wins, so a config author must place specific bindings before general ones; every malformed field raises a named error rather than taking a silent default."
    },
    {
      "id": "class:runner/graph_config.py:GraphConfigError",
      "type": "class",
      "name": "GraphConfigError",
      "filePath": "runner/graph_config.py",
      "lineRange": [58, 65],
      "summary": "Raised on any malformed or missing config field, always naming the offending binding.",
      "tags": ["exception", "fail-closed", "error-handling"],
      "complexity": "simple"
    },
    {
      "id": "class:runner/graph_config.py:Binding",
      "type": "class",
      "name": "Binding",
      "filePath": "runner/graph_config.py",
      "lineRange": [74, 114],
      "summary": "One node-to-artifact binding: the match criteria (folder prefix and/or node type), the target tier, the optional canonical artifact path, and the collection key. Its matches method decides whether a given node is routed by this binding.",
      "tags": ["data-model", "dataclass", "binding", "routing"],
      "complexity": "moderate"
    },
    {
      "id": "class:runner/graph_config.py:GraphConfig",
      "type": "class",
