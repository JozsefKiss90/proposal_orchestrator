      "lineRange": [222, 236],
      "summary": "Serialises an object to order-preserving canonical JSON for the slow-path comparison, so key or element reordering still registers as a divergence.",
      "tags": ["serialization", "canonicalization", "determinism"],
      "complexity": "simple"
    },
    {
      "id": "function:runner/graph_determinism_check.py:_staged_rel_paths",
