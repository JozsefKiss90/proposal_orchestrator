   "name": "unit_cost_budget.py",
   "filePath": "runner/unit_cost_budget.py",
   "summary": "Deterministic unit-cost budget deriver: computes a unit-cost (MSCA-style) budget as confirmed months times published rates times host-country coefficient, in a pure core plus a component wrapper that resolves inputs from durable state and writes the artifact atomically.",
   "tags": [
    "deterministic-component",
    "budget",
    "unit-cost",
    "phase7",
    "determinism"
   ],
   "complexity": "complex",
   "languageNotes": "Determinism is the anti-fabrication guarantee here, closed by a byte-equal replay check; an unresolved host coefficient still yields every host-independent line plus an explicit unresolved marker."
  },
