{
 "nodes": [
  {
   "id": "config:.claude/workflows/system_orchestration/manifest.compile.yaml",
   "type": "config",
   "name": "manifest.compile.yaml",
   "filePath": ".claude/workflows/system_orchestration/manifest.compile.yaml",
   "summary": "The compiled workflow manifest and executable spine of the engine: it declares the DAG execution model, a node_registry of 13 phase nodes binding each to its agent, skills, deterministic components and entry/exit gates, a 17-entry edge_registry of gate-guarded transitions, a 14-entry gate_registry and a 31-entry artifact registry. Its gate_registry predicate_refs are authoritative over which gate predicates actually execute.",
   "tags": [
    "workflow-manifest",
    "dag-definition",
    "gate-registry",
    "binding-authority",
    "configuration"
   ],
   "complexity": "complex",
   "languageNotes": "The gate_registry nests predicate_refs inside prose conditions, so a predicate defined in gate_rules_library.yaml but absent from a condition's predicate_refs is never evaluated."
  },
  {
   "id": "config:.claude/workflows/system_orchestration/agent_catalog.yaml",
   "type": "config",
   "name": "agent_catalog.yaml",
   "filePath": ".claude/workflows/system_orchestration/agent_catalog.yaml",
   "summary": "Declares the 20 workflow agents with their role, constitutional scope, declared tier reads and writes, explicit must_not prohibitions and phase alignment. Named by the constitution as an authoritative source of agent scope; three agents are cross-phase and proposal_writer is marked deprecated by the Phase 8 refactor.",
   "tags": [
    "agent-catalog",
    "binding-authority",
    "phase-alignment",
    "configuration",
    "tier-bindings"
   ],
   "complexity": "complex"
  },
  {
   "id": "config:.claude/workflows/system_orchestration/skill_catalog.yaml",
   "type": "config",
   "name": "skill_catalog.yaml",
   "filePath": ".claude/workflows/system_orchestration/skill_catalog.yaml",
   "summary": "Declares the 27 skills, each an atomic single-Claude-invocation unit, with its execution mode (predominantly TAPM), output contract, purpose, consuming agents, declared tier reads and writes and constitutional constraints. A skill may never invoke another skill.",
   "tags": [
    "skill-catalog",
    "binding-authority",
    "output-contract",
    "tapm",
    "configuration"
   ],
   "complexity": "complex",
   "languageNotes": "execution_mode separates TAPM skills (Claude reads declared inputs from disk via tools) from the lightweight cli-prompt path; a few entries leave it unset."
  },
  {
   "id": "config:.claude/workflows/system_orchestration/gate_rules_library.yaml",
   "type": "config",
   "name": "gate_rules_library.yaml",
   "filePath": ".claude/workflows/system_orchestration/gate_rules_library.yaml",
   "summary": "The machine-evaluable predicate library behind all 14 gates: 149 declared predicates, each carrying a predicate_id, type, evaluation function, args, prose condition and operator-facing fail message. The manifest's predicate_refs select which of these actually run.",
   "tags": [
    "gate-predicates",
    "validation-rules",
    "fail-closed",
    "binding-authority",
    "configuration"
   ],
   "complexity": "complex",
   "languageNotes": "Predicate ids follow a gNN_pNN scheme keyed to gate ordinal rather than gate_id, so the g02_* predicates belong to phase_01_gate."
  },
  {
   "id": "config:.claude/workflows/system_orchestration/quality_gates.yaml",
   "type": "config",
   "name": "quality_gates.yaml",
   "filePath": ".claude/workflows/system_orchestration/quality_gates.yaml",
   "summary": "The prose-level definition of the 15 quality gates: name, description, evaluation point, fail action and the human-readable conditions each gate enforces. Budget Consistency is the only gate flagged bypass_prohibited, matching the constitution's categorical Phase 8 block.",
   "tags": [
    "quality-gates",
    "gate-conditions",
    "fail-closed",
    "configuration",
    "validation"
   ],
   "complexity": "complex"
  },
  {
   "id": "config:.claude/workflows/system_orchestration/artifact_schema_specification.yaml",
   "type": "config",
   "name": "artifact_schema_specification.yaml",
   "filePath": ".claude/workflows/system_orchestration/artifact_schema_specification.yaml",
   "summary": "The canonical artifact schema specification: field-level schemas for Tier 4 phase outputs, Tier 5 deliverables, proposal sections, gate results, operational and dev-graph artifacts, Tier 3 sources, Tier 2A/2B extracts and integration validation, plus a 22-entry schema_id_registry mapping each schema_id to its artifact and section. Agent output that diverges from these schemas is a failure, not an alternative valid reading.",
   "tags": [
    "artifact-schemas",
    "schema-definition",
    "binding-authority",
    "validation",
    "configuration"
   ],
   "complexity": "complex",
   "languageNotes": "Every canonical artifact carries a versioned schema_id of the form orch.<scope>.<artifact>.v1, which the runtime validates rather than repairs."
  },
  {
   "id": "config:.claude/workflows/system_orchestration/tier_bindings.yaml",
   "type": "config",
   "name": "tier_bindings.yaml",
   "filePath": ".claude/workflows/system_orchestration/tier_bindings.yaml",
   "summary": "Maps the workflow onto the repository document model: for Tier 1 through Tier 5 plus integrations and runtime it declares the root path, role, subpaths, extracted artifacts, read authority and write constraint, including the Tier 2A constraint against treating grant agreement annexes as a proposal schema.",
   "tags": [
    "tier-model",
    "path-bindings",
    "read-write-authority",
    "configuration",
    "traceability"
   ],
   "complexity": "moderate"
  },
  {
   "id": "config:.claude/workflows/system_orchestration/global_rules.yaml",
   "type": "config",
   "name": "global_rules.yaml",
   "filePath": ".claude/workflows/system_orchestration/global_rules.yaml",
   "summary": "Cross-cutting invariants binding every phase: determinism, failure on missing required inputs, mandatory tier traceability, durable Tier 4 writes, prohibitions on fabricating project facts, call constraints and budget estimates, the budget-gate-before-finalization rule and the evaluation-success optimisation target.",
   "tags": [
    "global-rules",
    "anti-fabrication",
    "determinism",
    "fail-closed",
    "configuration"
   ],
   "complexity": "simple"
  },
  {
