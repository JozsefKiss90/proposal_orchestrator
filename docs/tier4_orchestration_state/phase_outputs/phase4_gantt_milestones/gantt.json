  "milestones": [
    {
      "milestone_id": "MS1",
      "title": "Knowledge gaps prioritised",
      "due_month": 9,
      "verifiable_criterion": "The gap analysis is delivered and names, in priority order, the biodiversity knowledge gaps the three cases will address and the data each one needs.",
      "responsible_wp": "WP2",
      "depends_on_tasks": [
        "T2.1"
      ],
      "milestone_type": "intermediate_checkpoint"
    },
    {
      "milestone_id": "MS2",
      "title": "Architecture and joint protocols agreed",
      "due_month": 16,
      "verifiable_criterion": "The integration architecture, the case selection and the joint collection, metadata and processing protocols are all delivered, and every partner running a campaign has adopted the protocol in writing.",
      "responsible_wp": "WP3",
      "depends_on_tasks": [
        "T3.1"
      ],
      "milestone_type": "intermediate_checkpoint"
    },
    {
      "milestone_id": "MS3",
      "title": "All three campaigns running under the joint protocol",
      "due_month": 22,
      "verifiable_criterion": "The terrestrial, freshwater and marine campaigns have each collected at least one field round, the omics sampling protocol is delivered, and the reporting-needs assessment states what the outputs must carry.",
      "responsible_wp": "WP4"
    },
    {
      "milestone_id": "MS4",
      "title": "Training resource documented and the crosswalks published",
      "due_month": 28,
      "verifiable_criterion": "The training and validation resource is published with its split protocol, and the crosswalk package resolves every habitat label the project uses to the European classification and the global typology.",
      "responsible_wp": "WP6",
      "depends_on_tasks": [
        "T6.1",
        "T6.2"
      ],
      "milestone_type": "intermediate_checkpoint"
    },
    {
      "milestone_id": "MS5",
      "title": "Omics layer joined to the observation record",
      "due_month": 38,
      "verifiable_criterion": "The molecular dataset, the genome-to-space linkage report and the processing pipeline release are delivered, and a molecular record can be joined to an in-situ and a satellite record through the published metadata.",
      "responsible_wp": "WP5",
      "depends_on_tasks": [
        "T5.2",
        "T5.4"
      ],
      "milestone_type": "intermediate_checkpoint"
    },
    {
      "milestone_id": "MS6",
      "title": "Three realms delivered and the models benchmarked",
      "due_month": 38,
      "verifiable_criterion": "The three case datasets are delivered under one protocol, and the classification models report benchmark scores on each of them under the declared split.",
      "responsible_wp": "WP4",
      "depends_on_tasks": [
        "T4.1",
        "T4.2",
        "T4.3"
      ],
      "milestone_type": "intermediate_checkpoint"
    },
    {
      "milestone_id": "MS7",
      "title": "Cross-case verification complete and the indicators released",
      "due_month": 40,
      "verifiable_criterion": "The verification report states which harmonisation decisions survived transfer between realms and which did not, and the indicator decision-support release is available to the user network.",
      "responsible_wp": "WP4",
      "depends_on_tasks": [
        "T4.5"
      ],
      "milestone_type": "intermediate_checkpoint"
    },
