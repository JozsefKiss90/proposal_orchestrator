{
  "schema_id": "orch.phase8.canonical_reference_pack.v1",
  "run_id": "import uuid; print(uuid.uuid4())",
  "objectives": [
    {
      "id": "O1",
      "title": "Build one multisensory integration architecture that carries omics, in-situ and remote-sensing observation on a single pressure gradient",
      "measurable_target": "A prioritised knowledge-gap and data-need analysis, and an integration architecture specification covering the molecular, plot, airborne and satellite layers",
      "responsible_partner": "P02",
      "contributing_partners": [
        "P04",
        "P09",
        "P10",
        "P11",
        "P12"
      ],
      "provenance": "confirmed"
    },
    {
      "id": "O2",
      "title": "Agree joint data-collection, metadata and processing protocols, and publish them with crosswalks to the European habitat classification and the global ecosystem typology",
      "measurable_target": "One protocol set adopted across the three cases, a crosswalk package, a provenance-tracked pipeline release, and publication to the open science cloud and the common data spaces",
      "responsible_partner": "P10",
      "contributing_partners": [
        "P01",
        "P04",
        "P08",
        "P09"
      ],
      "provenance": "confirmed"
    },
    {
      "id": "O3",
      "title": "Turn the multi-season field archive and the case observations into documented training and validation resources",
      "measurable_target": "A published training and validation resource with a declared split protocol, in which site, season and treatment travel together into one fold",
      "responsible_partner": "P03",
      "contributing_partners": [
        "P01",
        "P12"
      ],
      "provenance": "confirmed"
    },
    {
      "id": "O4",
      "title": "Run three demonstration and verification cases along one agricultural pressure gradient, across the terrestrial, freshwater and marine realms",
      "measurable_target": "Three harmonised observation datasets, one per realm, and a cross-case report on which harmonisation decisions survived transfer between realms",
      "responsible_partner": "P03",
      "contributing_partners": [
        "P01",
        "P02",
        "P06",
        "P07",
        "P08",
        "P09",
        "P11"
      ],
      "provenance": "confirmed"
    },
    {
      "id": "O5",
      "title": "Deliver habitat and ecosystem classification and biodiversity trend prediction at case, regional and European scales",
      "measurable_target": "Benchmarked classification models for the three cases, European-scale habitat and ecosystem maps, and trend predictions with stated uncertainty",
      "responsible_partner": "P12",
      "contributing_partners": [
        "P01",
        "P02",
        "P07",
        "P08",
        "P11"
      ],
      "provenance": "confirmed"
    },
    {
      "id": "O6",
      "title": "Carry the validated indicators into policy reporting and into farm management, so biodiversity evidence reaches the sectors that create the pressure",
      "measurable_target": "A reporting-needs assessment agreed with competent authorities, an indicator decision-support release, and a usability evaluation run through a multi-country network of agricultural holdings",
      "responsible_partner": "P05",
      "contributing_partners": [
        "P04",
        "P06",
        "P11"
      ],
      "provenance": "confirmed"
    }
  ],
