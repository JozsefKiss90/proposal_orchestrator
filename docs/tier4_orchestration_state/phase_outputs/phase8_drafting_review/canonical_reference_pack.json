  "objectives": [
    {
      "id": "O1",
      "title": "Construct a harmonised five-year MATE soil-plant-atmosphere dataset",
      "measurable_target": "QC-controlled historical database and documented metadata",
      "provenance": "confirmed"
    },
    {
      "id": "O2",
      "title": "Identify physiologically meaningful hyperspectral early-warning signatures and establish their Sentinel-2 transferability",
      "measurable_target": "Validated hyperspectral/Sentinel-compatible feature library",
      "provenance": "confirmed"
    },
    {
      "id": "O3",
      "title": "Develop prospective uncertainty-aware crop water-stress forecasts",
      "measurable_target": "Calibrated forecasts at actionable horizons",
      "provenance": "confirmed"
    },
    {
      "id": "O4",
      "title": "Quantify temporal and Hungary->Bulgaria geographic transferability and evaluate adaptation",
      "measurable_target": "Independent transferability benchmark",
      "provenance": "confirmed"
    },
    {
      "id": "O5",
      "title": "Quantify research->commercial-field operational transferability",
      "measurable_target": "AgroVIR farmer-field evaluation",
      "provenance": "confirmed"
    },
    {
      "id": "O6",
      "title": "Translate validated predictions into irrigation priority and a functional web MVP",
      "measurable_target": "DrR web MVP + Field Decision Value + AgroVIR requirements assessment",
      "provenance": "confirmed"
    }
  ],
  "outcomes": [
    {
      "id": "OC1",
      "title": "A physiologically defined water-stress target and a Sentinel-2-transferable early-warning feature basis, replacing spectral-proxy stress definitions.",
      "linked_objectives": [
        "O1",
        "O2"
      ],
      "provenance": "confirmed"
    },
    {
      "id": "OC2",
      "title": "A prospective, uncertainty-aware stress-forecasting capability at actionable horizons, in place of static detection.",
      "linked_objectives": [
        "O3"
      ],
      "provenance": "confirmed"
    },
    {
      "id": "OC3",
      "title": "Quantified temporal and Hungary-to-Bulgaria transferability of the predictive model, with a stated local-calibration cost for adapting it to a new agro-environment.",
      "linked_objectives": [
        "O4"
      ],
      "provenance": "confirmed"
    },
    {
      "id": "OC4",
      "title": "Evidence of field-level decision value under commercial farming conditions, enabling model selection by usefulness rather than retrospective accuracy.",
      "linked_objectives": [
        "O5",
        "O6"
      ],
      "provenance": "confirmed"
    },
    {
      "id": "OC5",
      "title": "A research-to-operation delivery path: an externally evaluated web MVP and a named post-MSCA FMIS integration route.",
      "linked_objectives": [
        "O6"
      ],
      "provenance": "confirmed"
    },
    {
      "id": "OC6",
      "title": "A researcher profile combining biological understanding, scalable geospatial prediction and operational decision support, carried by an agreed and reviewed Career Development Plan.",
      "linked_objectives": [],
      "provenance": "confirmed"
    }
  ],
