{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBedrockRoleAccess",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::232538551827:role/proposal-orchestrator-bedrock-role"
      },
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowValidationHostRoleAccess",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::232538551827:role/proposal-orchestrator-ec2-ssm-role"
      },
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "*"
    }
  ]
}
