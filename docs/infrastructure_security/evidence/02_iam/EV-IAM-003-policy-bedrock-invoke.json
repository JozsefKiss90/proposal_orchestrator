{
    "PolicyVersion": {
        "Document": {
            "Version": "2012-10-17",
            "Statement": [
                {
                    "Sid": "AllowBedrockConverse",
                    "Effect": "Allow",
                    "Action": [
                        "bedrock:InvokeModel",
                        "bedrock:InvokeModelWithResponseStream"
                    ],
                    "Resource": [
                        "arn:aws:bedrock:*::foundation-model/anthropic.claude-*",
                        "arn:aws:bedrock:*:*:inference-profile/us.anthropic.claude-*"
                    ],
                    "Condition": {
                        "StringEquals": {
                            "aws:RequestedRegion": [
                                "eu-west-1",
                                "us-east-1"
                            ]
                        }
                    }
                }
            ]
        },
        "VersionId": "v1",
        "IsDefaultVersion": true,
        "CreateDate": "2026-05-29T17:42:06+00:00"
    }
}

