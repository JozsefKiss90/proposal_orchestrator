{
    "PolicyVersion": {
        "Document": {
            "Version": "2012-10-17",
            "Statement": [
                {
                    "Action": [
                        "bedrock:InvokeModel",
                        "bedrock:InvokeModelWithResponseStream"
                    ],
                    "Resource": [
                        "arn:aws:bedrock:eu-north-1:797661577394:inference-profile/eu.anthropic.claude-opus-4-6-v1",
                        "arn:aws:bedrock:eu-north-1:797661577394:inference-profile/eu.anthropic.claude-sonnet-4-6"
                    ],
                    "Effect": "Allow",
                    "Sid": "BedrockInvokeProfiles"
                },
                {
                    "Action": [
                        "bedrock:InvokeModel",
                        "bedrock:InvokeModelWithResponseStream"
                    ],
                    "Resource": [
                        "arn:aws:bedrock:eu-north-1::foundation-model/anthropic.claude-opus-4-6-v1",
                        "arn:aws:bedrock:eu-west-3::foundation-model/anthropic.claude-opus-4-6-v1",
                        "arn:aws:bedrock:eu-south-1::foundation-model/anthropic.claude-opus-4-6-v1",
                        "arn:aws:bedrock:eu-south-2::foundation-model/anthropic.claude-opus-4-6-v1",
                        "arn:aws:bedrock:eu-west-1::foundation-model/anthropic.claude-opus-4-6-v1",
                        "arn:aws:bedrock:eu-central-1::foundation-model/anthropic.claude-opus-4-6-v1",
                        "arn:aws:bedrock:eu-north-1::foundation-model/anthropic.claude-sonnet-4-6",
                        "arn:aws:bedrock:eu-west-3::foundation-model/anthropic.claude-sonnet-4-6",
                        "arn:aws:bedrock:eu-south-1::foundation-model/anthropic.claude-sonnet-4-6",
                        "arn:aws:bedrock:eu-south-2::foundation-model/anthropic.claude-sonnet-4-6",
                        "arn:aws:bedrock:eu-west-1::foundation-model/anthropic.claude-sonnet-4-6",
                        "arn:aws:bedrock:eu-central-1::foundation-model/anthropic.claude-sonnet-4-6"
                    ],
                    "Effect": "Allow",
                    "Sid": "BedrockInvokeRoutedModels"
                },
                {
                    "Action": "secretsmanager:GetSecretValue",
                    "Resource": "arn:aws:secretsmanager:eu-north-1:797661577394:secret:proposal-orchestrator/env-config-*",
                    "Effect": "Allow",
                    "Sid": "RuntimeSecretRead"
                },
                {
                    "Action": [
                        "kms:Decrypt",
                        "kms:DescribeKey"
                    ],
                    "Resource": "arn:aws:kms:eu-north-1:797661577394:key/*",
                    "Effect": "Allow",
                    "Sid": "KmsDecryptThroughKeyPolicy"
                },
                {
                    "Action": "sts:GetCallerIdentity",
                    "Resource": "*",
                    "Effect": "Allow",
                    "Sid": "CallerIdentity"
                },
                {
                    "Action": [
                        "ssm:DescribeAssociation",
                        "ssm:GetDeployablePatchSnapshotForInstance",
                        "ssm:GetDocument",
                        "ssm:DescribeDocument",
                        "ssm:GetManifest",
                        "ssm:GetParameter",
                        "ssm:GetParameters",
                        "ssm:ListAssociations",
                        "ssm:ListInstanceAssociations",
                        "ssm:PutInventory",
                        "ssm:PutComplianceItems",
                        "ssm:PutConfigurePackageResult",
                        "ssm:UpdateAssociationStatus",
                        "ssm:UpdateInstanceAssociationStatus",
                        "ssm:UpdateInstanceInformation"
                    ],
                    "Resource": "*",
                    "Effect": "Allow",
                    "Sid": "SsmAgentCore"
                },
                {
                    "Action": [
                        "ssmmessages:CreateControlChannel",
                        "ssmmessages:CreateDataChannel",
                        "ssmmessages:OpenControlChannel",
                        "ssmmessages:OpenDataChannel"
                    ],
                    "Resource": "*",
                    "Effect": "Allow",
                    "Sid": "SsmAgentMessages"
                },
                {
                    "Action": [
                        "ec2messages:AcknowledgeMessage",
                        "ec2messages:DeleteMessage",
                        "ec2messages:FailMessage",
                        "ec2messages:GetEndpoint",
                        "ec2messages:GetMessages",
                        "ec2messages:SendReply"
                    ],
                    "Resource": "*",
                    "Effect": "Allow",
                    "Sid": "SsmAgentEc2Messages"
                },
                {
                    "Action": [
                        "s3:ListBucket",
                        "s3:GetBucketLocation"
                    ],
                    "Resource": "arn:aws:s3:::proposal-orchestrator-deploy-797661577394",
                    "Effect": "Allow",
                    "Sid": "DeployBucketBundlesRead"
                },
                {
                    "Action": "s3:GetObject",
                    "Resource": "arn:aws:s3:::proposal-orchestrator-deploy-797661577394/bundles/*",
                    "Effect": "Allow",
                    "Sid": "DeployBucketBundlesObjects"
                }
            ]
        },
        "VersionId": "v1",
        "IsDefaultVersion": true,
        "CreateDate": "2026-10-25T21:14:31+00:00"
    }
