    "Policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"DenyInsecureTransport\",\"Effect\":\"Deny\",\"Principal\":\"*\",\"Action\":\"s3:*\",\"Resource\":[\"arn:aws:s3:::proposal-orchestrator-deploy-797661577394\",\"arn:aws:s3:::proposal-orchestrator-deploy-797661577394/*\"],\"Condition\":{\"Bool\":{\"aws:SecureTransport\":\"false\"}}},{\"Sid\":\"DenyPrincipalsOutsideAccount\",\"Effect\":\"Deny\",\"Principal\":\"*\",\"Action\":\"s3:*\",\"Resource\":[\"arn:aws:s3:::proposal-orchestrator-deploy-797661577394\",\"arn:aws:s3:::proposal-orchestrator-deploy-797661577394/*\"],\"Condition\":{\"StringNotEquals\":{\"aws:PrincipalAccount\":\"797661577394\"}}},{\"Sid\":\"DenyEncryptionHeaderOtherThanKms\",\"Effect\":\"Deny\",\"Principal\":\"*\",\"Action\":\"s3:PutObject\",\"Resource\":\"arn:aws:s3:::proposal-orchestrator-deploy-797661577394/*\",\"Condition\":{\"Null\":{\"s3:x-amz-server-side-encryption\":\"false\"},\"StringNotEquals\":{\"s3:x-amz-server-side-encryption\":\"aws:kms\"}}},{\"Sid\":\"DenyKmsHeaderWithoutKeyId\",\"Effect\":\"Deny\",\"Principal\":\"*\",\"Action\":\"s3:PutObject\",\"Resource\":\"arn:aws:s3:::proposal-orchestrator-deploy-797661577394/*\",\"Condition\":{\"Null\":{\"s3:x-amz-server-side-encryption-aws-kms-key-id\":\"true\",\"s3:x-amz-server-side-encryption\":\"false\"}}},{\"Sid\":\"DenyKmsKeyOtherThanProjectKey\",\"Effect\":\"Deny\",\"Principal\":\"*\",\"Action\":\"s3:PutObject\",\"Resource\":\"arn:aws:s3:::proposal-orchestrator-deploy-797661577394/*\",\"Condition\":{\"Null\":{\"s3:x-amz-server-side-encryption-aws-kms-key-id\":\"false\"},\"StringNotEquals\":{\"s3:x-amz-server-side-encryption-aws-kms-key-id\":\"arn:aws:kms:eu-north-1:797661577394:key/4ccc45a1-f205-4775-aa0b-195290bf1561\"}}},{\"Sid\":\"DenyRuntimeRoleExceptBundlesRead\",\"Effect\":\"Deny\",\"Principal\":\"*\",\"NotAction\":[\"s3:GetObject\",\"s3:ListBucket\",\"s3:GetBucketLocation\"],\"Resource\":[\"arn:aws:s3:::proposal-orchestrator-deploy-797661577394\",\"arn:aws:s3:::proposa